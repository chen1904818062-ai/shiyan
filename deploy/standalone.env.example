# Store real values only in Render's environment settings or an ignored local file.
TURSO_DATABASE_URL=libsql://your-shiyan-database.turso.io
TURSO_AUTH_TOKEN=
# At least 16 characters. Preserve for the original owner's migration.
APP_ACCESS_PASSWORD=
APP_DISPLAY_NAME=我的空间
# Keep this stable when migrating, so the same user's records remain visible.
APP_OWNER_ID=shiyan-private-owner
# Render supplies RENDER_EXTERNAL_URL. Set APP_BASE_URL on Tencent Cloud.
APP_BASE_URL=
MODEL_API_KEY=
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=
MODEL_NAME=

# Keep false until the owner has verified a real received code in /account.
APP_PUBLIC_SIGNUP=false
# Generate a stable random secret of at least 32 characters; never share it.
APP_AUTH_SECRET=
# Resend: API key with sending permission + sender at a verified domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional mainland China (+86) SMS. One template variable: the six-digit code.
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# Persistent global ceiling across all channels (rolling 24 hours).
AUTH_DAILY_SEND_LIMIT=200
